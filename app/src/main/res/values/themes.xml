<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VicProj.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <!-- Pictograma transparenta: fara logo in splash-ul de sistem, ca sa nu apara de doua ori. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.VicProj</item>
    </style>

    <style name="Theme.VicProj" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorBackground">@color/black</item>
    </style>
</resources>
